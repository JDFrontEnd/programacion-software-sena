ng="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="95"/><column index="2" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT a.id_asunto,a.estado,a.fecha_inicio,a.fecha_final,a.caso,c.id_cliente,c.nombre,p.id_procurador,p.nombre
FROM asunto AS a
INNER JOIN cliente AS c ON a.id_cliente = c.id_cliente
INNER JOIN procurador AS p ON a.id_procurador = p.id_procurador </sql><current_tab id="0"/></tab_sql></sqlb_project>
