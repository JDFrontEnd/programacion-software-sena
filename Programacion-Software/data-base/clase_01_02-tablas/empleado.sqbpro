 schema="main" name="telefonoEmpleado" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="81"/><column index="2" value="99"/><column index="3" value="92"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE empleado (
		id_empleado INTEGER PRIMARY KEY AUTOINCREMENT,
		nombre TEXT NOT NULL,
		fechaNacimiento DATE NOT NULL,
		paisNacimiento TEXT NOT NULL,
		departamentoNacimiento TEXT NOT NULL,
		ciudadNacimiento TEXT NOT NULL,
		direccionVia TEXT NOT NULL,
		direccionNumeroVia TEXT NOT NULL,
		direccionNumeroVivienda TEXT NOT NULL
);

CREATE TABLE telefonoEmpleado (
		id_telefono INTEGER PRIMARY KEY AUTOINCREMENT,
		telefono NUMERIC NOT NULL,
		id_empleado INTEGER REFERENCES empleado(&quot;id_empleado&quot;)
);

INSERT INTO empleado (nombre, fechaNacimiento, paisNacimiento, departamentoNacimiento, ciudadNacimiento, direccionVia, direccionNumeroVia, direccionNumeroVivienda) 
		VALUES
			(&quot;Juan Diego Mesa Lopez&quot;, &quot;2001-10-28&quot;,&quot;Colombia&quot;,&quot;Antioquia&quot;,&quot;Medellin&quot;,&quot;Carrera 31 B&quot;, &quot;82-45&quot;, &quot;Apto 301&quot;),
			(&quot;Chipi Chipi Renteria&quot;, &quot;2000-14-18&quot;,&quot;Colombia&quot;,&quot;Chocó&quot;,&quot;Quibdó&quot;,&quot;Carrera 45&quot;, &quot;30-10&quot;, &quot;Apto 30&quot;);
			
INSERT INTO telefonoEmpleado (telefono, id_empleado) 
		VALUES
			(3106455738, 3),
			(3145384878, 4);
			
SELECT e.id_empleado, e.nombre, e.fechaNacimiento, e.paisNacimiento,e.departamentoNacimiento,e.ciudadNacimiento,e.direccionVia,e.direccionNumeroVia,e.direccionNumeroVivienda, t.telefono, t.id_empleado
FROM empleado AS e INNER JOIN telefonoEmpleado AS t ON  t.id_empleado = e.id_empleado 

			
			
			
			
