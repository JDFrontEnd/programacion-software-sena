x="1" value="49"/><column index="2" value="37"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE GeneroLiterario (
	GeneroID INTEGER PRIMARY KEY AUTOINCREMENT,
	nombreGenero TEXT NOT NULL
);

CREATE TABLE libro (
	LibroID INTEGER PRIMARY KEY AUTOINCREMENT,
	titulo TEXT NOT NULL,
	autor TEXT NOT NULL,
	editorial TEXT NOT NULL,
	formato TEXT NOT NULL
);

INSERT INTO GeneroLiterario (nombreGenero) 
	VALUES
		('Narrativo'),
		('Lírico'),
		('Poético'),
		('Dramático'),
		('Didáctico');

INSERT INTO libro (titulo, autor, editorial, formato, GeneroID)
	VALUES
		('Cien años de soledad', 'Gabriel García Márquez','Editorial Sudamericana','Tapa dura / Tapa blanda / Ebook',  1),
		
		('Veinte poemas de amor y una canción desesperada', 'Pablo Neruda','Editorial Losada','Tapa blanda / Ebook', 2),
		
		('Romeo y Julieta', 'William Shakespeare','Editorial Sudamericana','Tapa dura / Tapa blanda / Ebook',4),
		
		('Ensayos', 'Michel de Montaigne','Editorial Cátedra','Tapa blanda / Ebook',5);
		
SELECT * 
FROM libro AS L
INNER JOIN GeneroLiterario AS G ON L.LibroID = G.GeneroID 

SELECT L.LibroID, L.titulo, L.autor, L.editorial, L.formato, L.GeneroID, G.nombreGenero
FROM  libro AS L
INNER JOIN  GeneroLiterario AS G ON L.GeneroID = G.GeneroID;

		</sql><current_tab id="0"/></tab_sql></sqlb_project>
